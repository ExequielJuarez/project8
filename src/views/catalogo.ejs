<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  // modo "categoria": una sección del menú con sus subcategorías como filtro
  // modo "tienda" / "novedades" / "ofertas" / "busqueda": listados con filtro de categorías
  const enCategoria = modo === "categoria";
  // Lo que se ve al cargar (si llegó con ?sub= ya viene filtrado)
  const pasaAlCargar = (p) => !subElegida || p.subcategoriaId === subElegida.id;
  const visiblesAlCargar = productos.filter(pasaAlCargar).length;
  const enc = locals.encabezado || {};
%>

  <!-- ═════════════ ENCABEZADO DE PÁGINA ═════════════ -->
  <section class="hero contenedor">
    <nav class="migas" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <% if (enCategoria) { %>
        <a href="/tienda">Tienda</a>
        <span>/</span>
        <% if (subElegida) { %>
          <a href="/categoria/<%= categoria.slug %>"><%= categoria.nombre %></a>
          <span>/</span>
          <span aria-current="page"><%= subElegida.nombre %></span>
        <% } else { %>
          <span aria-current="page"><%= categoria.nombre %></span>
        <% } %>
      <% } else if (modo === "busqueda") { %>
        <a href="/tienda">Tienda</a>
        <span>/</span>
        <span aria-current="page">Búsqueda</span>
      <% } else { %>
        <% if (modo !== "tienda") { %><a href="/tienda">Tienda</a><span>/</span><% } %>
        <span aria-current="page"><%= modo === "tienda" ? "Tienda" : enc.titulo %></span>
      <% } %>
    </nav>

    <% if (modo === "busqueda") { %>
      <p class="hero__bajada">Resultados para</p>
      <h1 class="hero__titulo hero__titulo--busqueda">“<%= busqueda %>”</h1>
    <% } else { %>
      <h1 class="hero__titulo"><%= enc.titulo %></h1>
      <p class="hero__bajada"><%= enc.bajada %></p>
    <% } %>
    <span class="hero__linea" aria-hidden="true"></span>

    <% if (enCategoria && grupo.opciones.length) { %>
      <nav class="subnav" aria-label="Tipos de <%= categoria.nombre %>">
        <a href="/categoria/<%= categoria.slug %>" class="subnav__item <%= !subElegida ? 'activo' : '' %>" data-sub-link="">Todos</a>
        <% grupo.opciones.forEach(o => { %>
          <a href="/categoria/<%= categoria.slug %>?sub=<%= o.valor %>" class="subnav__item <%= o.marcado ? 'activo' : '' %>" data-sub-link="<%= o.valor %>"><%= o.nombre %></a>
        <% }) %>
      </nav>
    <% } %>
  </section>

  <!-- ═════════════ CATÁLOGO ═════════════ -->
  <main class="catalogo contenedor" id="catalogo">
    <div class="catalogo__cuerpo">

      <!-- Filtros (barra lateral en PC / panel lateral en celular y tablet) -->
      <aside class="filtros" id="filtros" data-panel aria-label="Filtros" data-grupo="<%= grupo.campo %>">
        <div class="filtros__cabecera">
          <h2>Filtrar</h2>
          <button class="icono-btn" id="btnCerrarFiltros" aria-label="Cerrar filtros">
            <svg viewBox="0 0 24 24" width="20" height="20"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        </div>

        <% if (grupo.opciones.length) { %>
        <section class="filtro">
          <h3 class="filtro__titulo"><%= grupo.titulo %></h3>
          <div class="filtro__opciones">
            <% grupo.opciones.forEach(o => { %>
              <label class="check">
                <input type="checkbox" name="<%= grupo.campo %>" value="<%= o.valor %>" <%= o.marcado ? 'checked' : '' %>>
                <span class="check__caja"></span>
                <span class="check__texto"><%= o.nombre %></span>
              </label>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% if (talles.length) { %>
        <section class="filtro">
          <h3 class="filtro__titulo">Talle</h3>
          <div class="filtro__opciones">
            <% talles.forEach(t => { %>
              <label class="check">
                <input type="checkbox" name="talle" value="<%= t.valor %>">
                <span class="check__caja"></span>
                <span class="check__texto"><%= t.valor %></span>
              </label>
            <% }) %>
          </div>
        </section>
        <% } %>

        <% if (colores.length) { %>
        <section class="filtro">
          <h3 class="filtro__titulo">Color</h3>
          <div class="filtro__opciones">
            <% colores.forEach(color => { %>
              <label class="color" title="<%= color.nombre %>">
                <input type="checkbox" name="color" value="<%= color.valor %>">
                <span class="color__muestra" style="--muestra: <%= color.hex %>"></span>
                <span class="color__nombre"><%= color.nombre %></span>
              </label>
            <% }) %>
          </div>
        </section>
        <% } %>

        <section class="filtro">
          <h3 class="filtro__titulo">Precio</h3>
          <div class="rango" id="rango" data-min="<%= rangoPrecio.min %>" data-max="<%= rangoPrecio.max %>">
            <div class="rango__pista"><span class="rango__relleno" id="rangoRelleno"></span></div>
            <input type="range" id="precioMin" min="<%= rangoPrecio.min %>" max="<%= rangoPrecio.max %>" step="1000" value="<%= rangoPrecio.min %>" aria-label="Precio mínimo">
            <input type="range" id="precioMax" min="<%= rangoPrecio.min %>" max="<%= rangoPrecio.max %>" step="1000" value="<%= rangoPrecio.max %>" aria-label="Precio máximo">
          </div>
          <div class="rango__valores">
            <span id="precioMinTexto"><%= formatoPrecio(rangoPrecio.min) %></span>
            <span id="precioMaxTexto"><%= formatoPrecio(rangoPrecio.max) %></span>
          </div>
        </section>

        <button type="button" class="filtros__limpiar" id="btnLimpiar">
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M20 12a8 8 0 11-2.6-5.9M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Limpiar filtros
        </button>

        <div class="filtros__pie">
          <button class="btn btn--solido" id="btnAplicar">Ver resultados</button>
        </div>
      </aside>

      <div class="catalogo__lista">
        <!-- Barra de herramientas -->
        <div class="herramientas">
          <p class="herramientas__cantidad"><span id="cantidadVisible"><%= visiblesAlCargar %></span> <span id="cantidadPalabra"><%= visiblesAlCargar === 1 ? 'producto' : 'productos' %></span></p>

          <div class="herramientas__derecha">
            <label class="orden">
              <span class="orden__label">Ordenar por:</span>
              <span class="orden__select">
                <select id="orden">
                  <option value="destacados">Destacados</option>
                  <option value="precio-asc">Precio: menor a mayor</option>
                  <option value="precio-desc">Precio: mayor a menor</option>
                  <option value="nombre-asc">Nombre: A – Z</option>
                </select>
              </span>
            </label>
            <button class="btn-filtros" id="btnFiltros" aria-controls="filtros" aria-expanded="true">
              <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 7h10M18 7h2M4 17h2M10 17h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="16" cy="7" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="17" r="2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              Filtrar
              <span class="btn-filtros__badge" id="badgeFiltros" hidden>0</span>
            </button>
          </div>
        </div>

        <div class="chips" id="chipsActivos"></div>

        <!-- Grilla de productos -->
        <section class="grilla" id="grilla" aria-live="polite">
          <% productos.forEach((p, i) => { %>
            <%- include('partials/tarjeta', { p, i, oculta: !pasaAlCargar(p) }) %>
          <% }) %>

          <div class="vacio" id="vacio" <%= visiblesAlCargar ? 'hidden' : '' %>>
            <p class="vacio__titulo">Sin resultados</p>
            <% if (!productos.length) { %>
              <p><%= modo === 'ofertas' ? 'Por ahora no hay ofertas. ¡Volvé pronto!' : modo === 'busqueda' ? 'No encontramos prendas con esa búsqueda.' : 'Todavía no hay productos acá. ¡Muy pronto!' %></p>
              <a href="/tienda" class="btn btn--linea">Ver toda la colección</a>
            <% } else { %>
              <p>Probá quitando algunos filtros.</p>
              <button class="btn btn--linea" data-limpiar>Quitar filtros</button>
            <% } %>
          </div>
        </section>
      </div>
    </div>
  </main>

  <%- include('partials/footer', { tiraSimple: true }) %>
  <script src="/js/catalogo.js"></script>
</body>
</html>
