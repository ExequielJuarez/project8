<%
  const t = locals.tienda || {};
  const iconoCamion = '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M2.5 7h11v9h-11zM13.5 10h4l3 3v3h-7" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.7" fill="#2d2429" stroke="currentColor" stroke-width="1.3"/><circle cx="17" cy="17.5" r="1.7" fill="#2d2429" stroke="currentColor" stroke-width="1.3"/></svg>';
  const iconoCorazon = '<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>';
  const iconoInstagram = '<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="16.8" cy="7.3" r="1" fill="currentColor"/></svg>';
%>
<!-- ═════════════ BARRA DE ANUNCIOS ═════════════ -->
<div class="anuncios" aria-label="Promociones">
  <div class="contenedor anuncios__interior">
    <p class="anuncios__grupo">
      <span class="anuncios__item"><%- iconoCamion %> Envíos a todo el país</span>
      <span class="anuncios__sep" aria-hidden="true"></span>
      <span class="anuncios__item anuncios__texto-largo">Envío gratis en compras superiores a $60.000</span>
    </p>
    <% if (t.instagram) { %>
      <a href="<%= t.instagram %>" class="anuncios__redes" target="_blank" rel="noopener"><%- iconoCorazon %> Seguinos en Instagram <%- iconoInstagram %></a>
    <% } else { %>
      <span class="anuncios__redes"><%- iconoCorazon %> Seguinos en Instagram <%- iconoInstagram %></span>
    <% } %>
  </div>
</div>

<!-- ═════════════ HEADER ═════════════ -->
<header class="header" id="header">
  <div class="header__barra contenedor">
    <button class="icono-btn header__menu-btn" id="btnMenu" aria-label="Abrir menú" aria-expanded="false">
      <span class="hamburguesa"></span>
    </button>

    <form class="buscador" action="/buscar" method="GET" role="search" data-buscador>
      <input type="search" name="q" value="<%= locals.busqueda || '' %>" placeholder="Buscar prendas…" aria-label="Buscar prendas"
             autocomplete="off" maxlength="60" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sugerencias">
      <button type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <div class="sugerencias" id="sugerencias" role="listbox" aria-label="Sugerencias" hidden></div>
    </form>

    <a href="/" class="logo" aria-label="Akualoe Chic — Inicio">
      <%- include('logo', { variante: 'horizontal' }) %>
    </a>

    <div class="header__acciones">
      <button class="icono-btn header__buscar-movil" id="btnBuscarMovil" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <% if (esAdmin(locals.usuarioLocal)) { %>
        <%- include('notificaciones') %>
      <% } %>
      <% const cantFav = (locals.favoritosIds || []).length; %>
      <a href="/favoritos" class="icono-btn carrito-btn favoritos-btn" aria-label="Favoritos">
        <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
        <span class="carrito-btn__contador" id="contadorFavoritos" <%= cantFav ? '' : 'hidden' %>><%= cantFav %></span>
      </a>
      <% if (locals.usuarioLocal) { %>
        <div class="cuenta" id="cuenta">
          <button class="icono-btn cuenta__btn" id="cuentaBtn" aria-label="Mi cuenta" aria-expanded="false" aria-controls="cuentaMenu">
            <span class="cuenta__inicial"><%= usuarioLocal.nombre.charAt(0) %></span>
          </button>
          <div class="cuenta__menu" id="cuentaMenu" hidden>
            <p class="cuenta__hola">Hola, <strong><%= usuarioLocal.nombre %></strong></p>
            <p class="cuenta__email"><%= usuarioLocal.email %></p>
            <% if (esAdmin(usuarioLocal)) { %>
              <a href="/admin" class="cuenta__link cuenta__link--admin">Panel de administración →</a>
            <% } %>
            <a href="/mi-cuenta/pedidos" class="cuenta__link">Mis pedidos</a>
            <a href="/mi-cuenta/datos" class="cuenta__link">Mis datos</a>
            <a href="/favoritos" class="cuenta__link">Mis favoritos</a>
            <form action="/logout" method="POST">
              <button type="submit" class="cuenta__salir">Cerrar sesión</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <% const volverA = ['/login', '/'].includes(locals.currentPath) ? '' : '?volver=' + encodeURIComponent(currentPath); %>
        <a href="/login<%= volverA %>" class="icono-btn" aria-label="Iniciar sesión">
          <svg viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
      <% } %>
      <a href="/carrito" class="icono-btn carrito-btn" aria-label="Carrito">
        <svg viewBox="0 0 24 24" width="24" height="24"><path d="M5 8h14l-1.2 12H6.2L5 8z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 016 0v2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        <span class="carrito-btn__contador" id="contadorCarrito"><%= locals.cantidadCarrito || 0 %></span>
      </a>
    </div>
  </div>

  <div class="buscador-movil contenedor <%= locals.busqueda ? 'abierto' : '' %>" id="buscadorMovil">
    <form class="buscador buscador--movil" action="/buscar" method="GET" role="search" data-buscador>
      <input type="search" name="q" value="<%= locals.busqueda || '' %>" placeholder="Buscar prendas…" aria-label="Buscar prendas"
             autocomplete="off" maxlength="60" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="sugerenciasMovil">
      <button type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <div class="sugerencias" id="sugerenciasMovil" role="listbox" aria-label="Sugerencias" hidden></div>
    </form>
  </div>

  <nav class="nav" id="nav" aria-label="Principal">
    <ul class="nav__lista contenedor">
      <% (locals.nav || []).forEach(item => {
           const activo = locals.navActivo === item.clave || (item.claves || []).includes(locals.navActivo); %>
        <li class="nav__item <%= activo ? 'nav__item--activo' : '' %>">
          <a href="<%= item.url %>" <%- activo ? 'aria-current="page"' : '' %>>
            <%= item.nombre %>
            <% if (item.hijos.length) { %>
              <svg class="nav__chevron" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <% } %>
          </a>
          <% if (item.hijos.length) { %>
            <ul class="nav__sub">
              <% item.hijos.forEach(h => { %><li><a href="<%= h.url %>"><%= h.nombre %></a></li><% }) %>
            </ul>
          <% } %>
        </li>
      <% }) %>
      <li class="nav__item nav__item--movil"><a href="/favoritos">Favoritos<% if ((locals.favoritosIds || []).length) { %> <small>(<%= favoritosIds.length %>)</small><% } %></a></li>
    </ul>
  </nav>
</header>

<div class="overlay" id="overlay"></div>
